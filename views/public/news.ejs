<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/pagehead', { lead: 'News, events and notices from the college.' }) %>
<section class="section"><div class="container">
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-sm <%= !type ? 'btn-maroon' : 'btn-outline-secondary' %>" href="/news">All</a>
    <a class="btn btn-sm <%= type === 'news' ? 'btn-maroon' : 'btn-outline-secondary' %>" href="/news?type=news">News</a>
    <a class="btn btn-sm <%= type === 'event' ? 'btn-maroon' : 'btn-outline-secondary' %>" href="/news?type=event">Events</a>
    <a class="btn btn-sm <%= type === 'notice' ? 'btn-maroon' : 'btn-outline-secondary' %>" href="/news?type=notice">Notices</a>
  </div>
  <% if (!items.length) { %><p>Nothing published yet.</p><% } %>
  <div class="row g-3">
    <% items.forEach(function (n) { %>
      <div class="col-md-6 col-lg-4"><article class="news-card h-100">
        <span class="badge badge-type type-<%= n.type %>"><%= n.type %></span>
        <% if (n.event_date) { %><span class="small text-muted ms-2"><i class="bi bi-calendar-event"></i> <%= n.event_date %></span><% } %>
        <h2 class="h5 mt-2"><a href="/news/<%= n.slug %>"><%= n.title %></a></h2>
        <p class="mb-0"><%= n.summary %></p>
      </article></div>
    <% }) %>
  </div>
</div></section>
<%- include('../partials/footer') %>
