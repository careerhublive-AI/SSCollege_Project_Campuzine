<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const b = banners[0]; const heroImg = b && /^\/img\/[\w\/.-]+$/.test(b.image_url || '') ? b.image_url : null; %>
<section class="hero<%= heroImg ? ' hero-photo' : '' %>">
  <% if (heroImg) { %><img class="hero-bg" src="<%= heroImg %>" alt="" aria-hidden="true"><% } %>
  <div class="container">
    <div class="row align-items-center g-4 g-lg-5">
      <div class="col-lg-7">
        <p class="eyebrow"><%= site.affiliation %></p>
        <h1 class="hero-title"><%= b ? b.title : site.college_name %></h1>
        <% if (b && b.subtitle) { %><p class="hero-sub"><%= b.subtitle %></p><% } else if (site.tagline) { %><p class="hero-sub"><%= site.tagline %></p><% } %>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <a class="btn btn-gold btn-lg" href="/admissions">Admissions</a>
          <% if (b && b.link_url) { %><a class="btn btn-outline-light btn-lg" href="<%= b.link_url %>"><%= b.link_label || 'Learn more' %></a><% } %>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="hero-card">
          <h2 class="h5 mb-3"><i class="bi bi-megaphone"></i> Notices</h2>
          <% if (!latest.length) { %><p class="mb-0">No notices yet.</p><% } %>
          <ul class="list-unstyled notice-list mb-0">
            <% latest.forEach(function (n) { %>
              <li><a href="/news/<%= n.slug %>"><span class="badge badge-type type-<%= n.type %>"><%= n.type %></span> <%= n.title %></a></li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="stats">
  <div class="container">
    <div class="row text-center g-3">
      <div class="col-6 col-md-3"><div class="stat"><span class="stat-n"><%= departments.length %></span><span class="stat-l">Departments</span></div></div>
      <div class="col-6 col-md-3"><div class="stat"><span class="stat-n"><%= programmeCount %></span><span class="stat-l">Programmes</span></div></div>
      <div class="col-6 col-md-3"><a class="stat stat-link" href="/iqac"><span class="stat-n"><i class="bi bi-patch-check"></i></span><span class="stat-l">IQAC &amp; NAAC</span></a></div>
      <div class="col-6 col-md-3"><a class="stat stat-link" href="/student-achievements"><span class="stat-n"><i class="bi bi-trophy"></i></span><span class="stat-l">Achievements</span></a></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>Departments</h2><a href="/departments">All departments <i class="bi bi-arrow-right"></i></a></div>
    <div class="row g-3">
      <% departments.forEach(function (d) { %>
        <div class="col-sm-6 col-lg-3">
          <a class="tile" href="/departments/<%= d.slug %>">
            <i class="bi bi-bank tile-icon"></i>
            <span class="tile-title"><%= d.short_name || d.name %></span>
            <span class="tile-sub"><%= d.name %></span>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <div class="col-lg-7">
        <div class="section-head"><h2>News</h2><a href="/news">All news <i class="bi bi-arrow-right"></i></a></div>
        <% featured.forEach(function (n) { %>
          <article class="news-card">
            <span class="badge badge-type type-<%= n.type %>"><%= n.type %></span>
            <h3 class="h5 mt-2"><a href="/news/<%= n.slug %>"><%= n.title %></a></h3>
            <p class="mb-0"><%= n.summary %></p>
          </article>
        <% }) %>
      </div>
      <div class="col-lg-5">
        <div class="section-head"><h2>Upcoming events</h2><a href="/news?type=event">All events <i class="bi bi-arrow-right"></i></a></div>
        <% if (!events.length) { %><p>No upcoming events.</p><% } %>
        <% events.forEach(function (e) { const d = new Date(e.event_date); %>
          <a class="event" href="/news/<%= e.slug %>">
            <span class="event-date"><span class="event-day"><%= d.getUTCDate() %></span><span class="event-mon"><%= d.toLocaleString('en', { month: 'short', timeZone: 'UTC' }) %></span></span>
            <span class="event-title"><%= e.title %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
