<section class="page-head">
  <div class="container">
    <nav aria-label="breadcrumb"><ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <% (typeof crumbs !== 'undefined' ? crumbs : []).forEach(function (c) { %><li class="breadcrumb-item"><a href="<%= c.url %>"><%= c.title %></a></li><% }) %>
      <li class="breadcrumb-item active" aria-current="page"><%= title %></li>
    </ol></nav>
    <h1><%= title %></h1>
    <% if (typeof lead !== 'undefined' && lead) { %><p class="lead mb-0"><%= lead %></p><% } %>
  </div>
</section>
