<%- include('partials/top') %>
<div class="page-title"><h1><%= title %></h1><a class="btn btn-outline-secondary" href="/admin/news">Back</a></div>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="/admin/news<%= item.id ? '/' + item.id : '' %>" class="card-a">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-md-3"><label class="form-label" for="type">Type</label><select class="form-select" id="type" name="type">
      <% ['news', 'event', 'notice'].forEach(function (t) { %><option value="<%= t %>" <%= item.type === t ? 'selected' : '' %> class="text-capitalize"><%= t %></option><% }) %></select></div>
    <div class="col-md-9"><label class="form-label" for="title">Title</label><input class="form-control" id="title" name="title" required maxlength="250" value="<%= item.title || '' %>"></div>
    <div class="col-12"><label class="form-label" for="summary">Summary</label><input class="form-control" id="summary" name="summary" maxlength="500" value="<%= item.summary || '' %>"></div>
    <div class="col-12"><label class="form-label" for="body">Content (HTML)</label><textarea class="form-control code" id="body" name="body" rows="10"><%= item.body || '' %></textarea></div>
    <div class="col-md-3"><label class="form-label" for="event_date">Event date</label><input class="form-control" id="event_date" name="event_date" type="date" value="<%= item.event_date || '' %>"></div>
    <div class="col-md-3"><label class="form-label" for="academic_year_id">Academic year</label><select class="form-select" id="academic_year_id" name="academic_year_id">
      <% years.forEach(function (y) { %><option value="<%= y.id %>" <%= item.academic_year_id == y.id ? 'selected' : '' %>><%= y.label %></option><% }) %></select></div>
    <div class="col-md-3"><label class="form-label" for="department_id">Department</label><select class="form-select" id="department_id" name="department_id">
      <option value="">College-wide</option><% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= item.department_id == d.id ? 'selected' : '' %>><%= d.name %></option><% }) %></select></div>
    <div class="col-md-3"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status">
      <option value="draft" <%= item.status !== 'published' ? 'selected' : '' %>>Draft</option><option value="published" <%= item.status === 'published' ? 'selected' : '' %>>Published</option></select></div>
    <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="is_featured" name="is_featured" value="1" <%= item.is_featured ? 'checked' : '' %>><label class="form-check-label" for="is_featured">Feature on the homepage</label></div></div>
  </div>
  <button class="btn btn-maroon mt-4">Save</button>
</form>
<%- include('partials/bottom') %>
