<%- include('partials/top') %>
<div class="page-title"><h1>My account</h1></div>
<div class="card-a col-lg-6">
  <p class="mb-3"><strong><%= currentUser.full_name %></strong> · <%= currentUser.email %> · <%= currentUser.role_name %></p>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-3"><label class="form-label" for="cp">Current password</label><input class="form-control" id="cp" name="current_password" type="password" autocomplete="current-password" required></div>
    <div class="mb-3"><label class="form-label" for="np">New password (at least 10 characters)</label><input class="form-control" id="np" name="new_password" type="password" autocomplete="new-password" minlength="10" required></div>
    <div class="mb-3"><label class="form-label" for="np2">Repeat new password</label><input class="form-control" id="np2" name="confirm_password" type="password" autocomplete="new-password" minlength="10" required></div>
    <button class="btn btn-maroon">Change password</button>
  </form>
</div>
<%- include('partials/bottom') %>
