<%- include('partials/top') %>
<div class="page-title"><h1><%= title %></h1><a class="btn btn-outline-secondary" href="/admin/departments">Back</a></div>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="post" action="/admin/departments<%= d.id ? '/' + d.id : '' %>" class="card-a">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" required value="<%= d.name || '' %>" placeholder="Department of English"></div>
    <div class="col-md-3"><label class="form-label" for="short_name">Short name</label><input class="form-control" id="short_name" name="short_name" value="<%= d.short_name || '' %>"></div>
    <div class="col-md-3"><label class="form-label" for="slug">Web address</label><input class="form-control" id="slug" name="slug" value="<%= d.slug || '' %>"></div>
    <div class="col-12"><label class="form-label" for="description">Profile</label><textarea class="form-control" id="description" name="description" rows="4"><%= d.description || '' %></textarea></div>
    <div class="col-md-4"><label class="form-label" for="hod_name">Head of department</label><input class="form-control" id="hod_name" name="hod_name" value="<%= d.hod_name || '' %>"></div>
    <div class="col-md-4"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" value="<%= d.email || '' %>"></div>
    <div class="col-md-4"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" name="phone" value="<%= d.phone || '' %>"></div>
    <div class="col-12"><label class="form-label" for="faculty_text">Faculty</label><textarea class="form-control" id="faculty_text" name="faculty_text" rows="5" placeholder="Name | Designation"><%= d.faculty_text || '' %></textarea><div class="form-text">One person per line, as <em>Name | Designation</em>.</div></div>
    <div class="col-md-3"><label class="form-label" for="sort_order">Order</label><input class="form-control" id="sort_order" name="sort_order" type="number" value="<%= d.sort_order || 0 %>"></div>
    <div class="col-md-3"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="active">Active</option><option value="archived" <%= d.status === 'archived' ? 'selected' : '' %>>Archived</option></select></div>
  </div>
  <button class="btn btn-maroon mt-4">Save</button>
</form>
<%- include('partials/bottom') %>
