<%- include('partials/top') %>
<div class="page-title"><h1>Audit log</h1><span class="text-muted small">Latest 300 entries · times in UTC</span></div>
<div class="table-a table-responsive"><table class="table table-sm align-middle">
  <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Item</th><th>Details</th><th>IP</th></tr></thead>
  <tbody><% logs.forEach(function (a) { %><tr><td class="small text-nowrap"><%= a.created_at %></td><td><%= a.full_name || '—' %></td><td><%= a.action %></td><td><%= a.entity %> <%= a.entity_id || '' %></td>
    <td class="small text-break"><%= (a.details || '').slice(0, 160) %></td><td class="small"><%= a.ip_address %></td></tr><% }) %></tbody>
</table></div>
<%- include('partials/bottom') %>
