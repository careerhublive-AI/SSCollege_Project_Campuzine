<%- include('../partials/top') %>
<div class="page-title"><h1><%= title %></h1><a class="btn btn-outline-secondary" href="/admin/sabari/faqs">Back</a></div>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<% if (faq.from_unanswered) { %><div class="alert alert-info">Converting a visitor's question into an FAQ. When you save, the question is marked as converted.</div><% } %>
<form method="post" action="/admin/sabari/faqs<%= faq.id ? '/' + faq.id : '' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (faq.from_unanswered) { %><input type="hidden" name="from_unanswered" value="<%= faq.from_unanswered %>"><% } %>
  <div class="row g-4">
    <div class="col-lg-6"><div class="card-a h-100">
      <h2 class="h5">English</h2>
      <div class="mb-3"><label class="form-label" for="question_en">Question</label><input class="form-control" id="question_en" name="question_en" maxlength="500" value="<%= faq.en.question || '' %>"></div>
      <div class="mb-3"><label class="form-label" for="answer_en">Answer</label><textarea class="form-control" id="answer_en" name="answer_en" rows="5"><%= faq.en.answer || '' %></textarea></div>
      <div><label class="form-label" for="keywords_en">Keywords and synonyms</label><textarea class="form-control" id="keywords_en" name="keywords_en" rows="2" placeholder="admission, apply, application, join"><%= faq.keywords_en || '' %></textarea>
        <div class="form-text">Separate with commas. A phrase like “hod english” matches only when both words appear.</div></div>
    </div></div>
    <div class="col-lg-6"><div class="card-a h-100">
      <h2 class="h5" lang="ml">മലയാളം</h2>
      <div class="mb-3"><label class="form-label" for="question_ml">Question (Malayalam)</label><input class="form-control" id="question_ml" name="question_ml" lang="ml" maxlength="500" value="<%= faq.ml.question || '' %>"></div>
      <div class="mb-3"><label class="form-label" for="answer_ml">Answer (Malayalam)</label><textarea class="form-control" id="answer_ml" name="answer_ml" lang="ml" rows="5"><%= faq.ml.answer || '' %></textarea></div>
      <div><label class="form-label" for="keywords_ml">Keywords (Malayalam)</label><textarea class="form-control" id="keywords_ml" name="keywords_ml" lang="ml" rows="2" placeholder="അഡ്മിഷ, പ്രവേശന, അപേക്ഷ"><%= faq.keywords_ml || '' %></textarea>
        <div class="form-text">Use the start of the word (e.g. “കോഴ്സ”) so it also matches forms like “കോഴ്സുകളുണ്ട്”.</div></div>
    </div></div>
    <div class="col-12"><div class="card-a">
      <div class="row g-3">
        <div class="col-md-4"><label class="form-label" for="category_id">Topic</label><select class="form-select" id="category_id" name="category_id"><option value="">No topic</option>
          <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= faq.category_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
        <div class="col-md-4"><label class="form-label" for="source_url">Related page link</label><input class="form-control" id="source_url" name="source_url" value="<%= faq.source_url || '' %>" placeholder="/admissions"></div>
        <div class="col-md-2"><label class="form-label" for="priority">Priority</label><input class="form-control" id="priority" name="priority" type="number" value="<%= faq.priority || 0 %>"></div>
        <div class="col-md-2"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status">
          <% [['draft', 'Draft'], ['published', 'Published'], ['unpublished', 'Unpublished']].forEach(function (s) { %><option value="<%= s[0] %>" <%= faq.status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></div>
        <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="quick_reply" name="quick_reply" value="1" <%= faq.quick_reply ? 'checked' : '' %>><label class="form-check-label" for="quick_reply">Show this question as a quick-reply button under its topic</label></div></div>
        <div class="col-12 form-text">You can use {{address}}, {{phone}}, {{email}} and {{office_hours}} in answers. They are filled from College information, so they stay current.</div>
      </div>
    </div></div>
  </div>
  <button class="btn btn-maroon mt-4">Save FAQ</button>
</form>
<%- include('../partials/bottom') %>
