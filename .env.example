# Copy to .env for local use. On Hostinger, enter these as environment variables of the Node.js app.
NODE_ENV=production
PORT=3000

# A long random string (at least 32 characters). Keep it secret.
SESSION_SECRET=

# Database: "mysql" on Hostinger, "sqlite" for a quick local demo.
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# First Super Admin account, created on the very first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 0 to stop the app running database migrations at startup.
AUTO_MIGRATE=1
